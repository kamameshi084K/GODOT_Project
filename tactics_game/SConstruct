#!/usr/bin/env python
import os
import sys

# godot-cppのビルド設定を読み込む
env = SConscript("godot-cpp/SConstruct")

# インクルードパスの設定
env.Append(CPPPATH=[".", "src"])

# ソースファイルをすべて取得
sources = Glob("src/*.cpp")

# 出力先とファイル名の統一 (game/bin/ 以下に出力)
if env["platform"] == "macos":
    library = env.SharedLibrary(
        "game/bin/tactics_core.macos.template_debug.framework/tactics_core",
        source=sources,
    )
else:
    # Windows/Linux 共通
    library = env.SharedLibrary(
        "bin/tactics_core",
        source=sources,
    )

Default(library)